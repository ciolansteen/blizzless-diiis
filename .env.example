# Database connection
DB_HOST=diiis-na-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# PostgreSQL container (must match DB_* above)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=diablo

# Server IP bindings
# BIND_IP: interface the server listens on (0.0.0.0 = all interfaces, required for Docker)
BIND_IP=0.0.0.0
# REST_IP: interface the REST login server listens on
REST_IP=0.0.0.0
# PUBLIC_IP: IP advertised to the D3 client (must be reachable from the client machine)
PUBLIC_IP=127.0.0.1
# LOG_MODE: Console (plain, for docker logs) | Ansi (table, interactive terminal only)
# LOG_LEVEL_MIN/MAX: RenameAccountLog(0) Debug(3) Info(6) Warn(8) Error(9) Fatal(10) PacketDump(13)

# Logging
LOG_MODE=Console
LOG_LEVEL_MIN=Debug
LOG_LEVEL_MAX=Fatal
## Show Colors in docker terminal
TERM=xterm-256color
